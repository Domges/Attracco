# --- Sito ---
NEXT_PUBLIC_SITE_URL=https://attracco.app

# --- Claude API (concierge) ---
ANTHROPIC_API_KEY=sk-ant-...
# Modello e sforzo di ragionamento del concierge
CONCIERGE_MODEL=claude-opus-5-5
CONCIERGE_EFFORT=low

# --- Database (PostgreSQL: Neon, Supabase, RDS... preferibilmente region UE) ---
DATABASE_URL=postgres://user:password@host:5432/attracco

# --- Stripe (Connect, destination charges) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Endpoint Connect (eventi degli account connessi, es. account.updated) sullo stesso URL
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# Commissione piattaforma in basis point (1000 = 10%)
PLATFORM_FEE_BPS=1500
# Account Stripe Connect dei fornitori (acct_...), uno per fornitore del catalogo.
# Facoltativi: per i fornitori registrati tramite /partner l'account è creato
# dall'onboarding e salvato nel database, che prevale su queste variabili.
STRIPE_ACCOUNT_CHEF_MARE=acct_...
STRIPE_ACCOUNT_NCC_LEVANTE=acct_...
STRIPE_ACCOUNT_VELA_ADRIATICO=acct_...

# --- Back-office (HTTP Basic Auth su /admin) ---
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-questa-password-lunga

# --- Data retention (mesi dopo la data del servizio) ---
RETENTION_MONTHS=[da definire con il DPO]
# Candidature di fornitori non accolte o ritirate: cancellazione dopo N mesi
PROVIDER_APPLICATION_RETENTION_MONTHS=[da definire con il DPO]
# Fornitori cessati: anonimizzazione dopo N mesi dalla cessazione (obblighi civilistici e fiscali)
PROVIDER_RETENTION_MONTHS=[da definire con il DPO]
